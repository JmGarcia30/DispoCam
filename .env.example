# Public Supabase values used by the admin sign-in client. These are safe to expose;
# authorization still happens in server routes and the service-role key remains private.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional tuning.
UPLOAD_INTENT_TTL_SECONDS=600
MAX_UPLOAD_BYTES=15728640
